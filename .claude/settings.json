{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./data/real/**)",
      "Read(./out/real/**)",
      "Read(./physionet.org/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_data_dir.py\"",
            "statusMessage": "Checking for protected-path access"
          }
        ]
      }
    ]
  }
}
