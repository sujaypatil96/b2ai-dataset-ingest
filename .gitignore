# Source datasets (large; downloaded under their respective DUAs). Not committed.
/data/*
!/data/.gitkeep

# Synthetic-data generator checkouts (cloned repos, not our source)
/data_synth/

# Real Bridge2AI-Voice PhysioNet download — credentialed access, HIPAA/PII-sensitive.
# Must never be committed or pushed.
/physionet.org/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Output artifacts
/out/

# Browser-automation scratch (Playwright MCP page/console dumps)
.playwright-mcp/

# OS / editor
.DS_Store
.idea/
.vscode/
