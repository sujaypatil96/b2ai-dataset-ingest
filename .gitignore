# Synthetic / downloaded input data (large; fetched via scripts/fetch_synthetic_data.sh)
# NOTE: /data/ holds REAL, licensed, non-public data — never commit, never read it.
/data/*
!/data/.gitkeep

# Synthetic-data generator checkouts (cloned repos, not our source)
/data_synth/

# Real Bridge2AI-Voice PhysioNet download — credentialed access, HIPAA/PII-sensitive.
# Must never be committed or pushed.
/physionet.org/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Output artifacts
/out/

# Browser-automation scratch (Playwright MCP page/console dumps)
.playwright-mcp/

# OS / editor
.DS_Store
.idea/
.vscode/
